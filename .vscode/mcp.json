{
  // For more information, visit: https://angular.dev/ai/mcp
  "servers": {
    "angular-cli": {
      "command": "npx",
      "args": [
        "-y",
        "@angular/cli",
        "mcp"
      ]
    },
    "dungeon-rag": {
      "type": "stdio",
      "command": "${workspaceFolder}/bin/rag-mcp.exe",
      "env": {
        "DB_PATH": "${workspaceFolder}/db/rag.db",
        "LLAMACPP_BASE_URL": "http://localhost:8080",
        "LLAMACPP_LLM_URL": "http://localhost:8081"
      }
    }
  }
}